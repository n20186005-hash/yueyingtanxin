---
import Layout from '../layouts/Layout.astro';
---
<Layout title="找不到頁面｜蘭潭月影潭心" description="此頁面不存在，請回首頁或選擇月影潭心參觀指南。" path="/404/" noIndex>
  <section class="site-shell pt-28 pb-20">
    <div class="eyebrow">404</div>
    <h1 class="section-title">找不到這個頁面</h1>
    <p class="section-copy mt-6">網址可能有誤，請從首頁或下方指南繼續瀏覽。</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="primary-button" href="/">回首頁</a>
      <a class="secondary-button" href="/opening-hours/">開放時間與門票</a>
      <a class="secondary-button" href="/transport/">交通與停車</a>
    </div>
  </section>
</Layout>

---
import '../styles/global.css';

const title = '蘭潭月影潭心｜嘉義景點：開放時間、夜間點燈與交通攻略';
const description = '嘉義蘭潭月影潭心的遊客指南：園區免費、全天候開放；附夜間點燈、音樂噴泉、即時天氣與一週預報、機場／公車／計程車交通方式、停車與周邊設施、季節策略與推薦路線。';
const DOMAIN_NAME = 'yueyingtanxin.com';
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `https://${DOMAIN_NAME}/`;
const ogImageURL = Astro.site ? new URL('/images/og.webp', Astro.site).toString() : `https://${DOMAIN_NAME}/images/og.webp`;
const mapsURL = 'https://www.google.com/maps/place/%E5%85%B0%E6%BD%AD%E6%9C%88%E5%BD%B1%E6%BD%AD%E5%BF%83/data=!4m7!3m6!1s0x346e9458614570cb:0xfde645383820da8b!8m2!3d23.465877!4d120.48071!16s%2Fg%2F11fxxxvc6p!19sChIJy3BFYViUbjQRi9ogODhF5v0?authuser=0&hl=zh-CN&rclk=1';
const mapsShareURL = 'https://maps.app.goo.gl/TGMYG7zRJhNdXm1q9';
const govtTourismURL = 'https://taiwan.net.tw/';
const ratingValue = 4.2;
const ratingCount = 4180;
const ratingSynced = '2026 年 9 月';
const nearbyLandmark1 = '蘭潭音樂噴泉';
const nearbyLandmark2 = '檜意森活村';

const attractionStructuredData = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `https://${DOMAIN_NAME}/#attraction`,
  name: '蘭潭月影潭心',
  alternateName: ['月影潭心', '蘭潭', '嘉義市 蘭潭月影潭心'],
  description,
  url: canonicalURL,
  image: [ogImageURL],
  isAccessibleForFree: true,
  priceRange: '免費',
  telephone: '+886-5-224-8917',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '東區鹿寮里紅毛埤187-4號（蘭潭風景區）',
    addressLocality: '嘉義市',
    addressRegion: '臺灣省',
    postalCode: '600',
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 23.465877,
    longitude: 120.48071,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'https://schema.org/Monday',
      'https://schema.org/Tuesday',
      'https://schema.org/Wednesday',
      'https://schema.org/Thursday',
      'https://schema.org/Friday',
      'https://schema.org/Saturday',
      'https://schema.org/Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  hasMap: mapsShareURL,
  sameAs: [mapsShareURL, mapsURL, govtTourismURL],
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '臺灣', item: `https://${DOMAIN_NAME}/` },
    { '@type': 'ListItem', position: 2, name: '嘉義市', item: `https://${DOMAIN_NAME}/` },
    { '@type': 'ListItem', position: 3, name: '蘭潭月影潭心', item: `https://${DOMAIN_NAME}/#attraction` },
  ],
};

const faqs = [
  {
    question: '蘭潭月影潭心什麼時候開放？點燈時間是幾點？',
    answer: '月影潭心位於蘭潭風景區的戶外公共空間，免費且全天候開放、不設售票口。夜間照明一般於傍晚、日落前後亮起，建議在日落前後一次收集日景與夜景。確切亮燈與音樂噴泉場次會隨季節、維護與天候調整，出發前請以現場與嘉義市官方公告為準。',
  },
  {
    question: '蘭潭月影潭心需要門票嗎？',
    answer: '不需要。月影潭心位於蘭潭風景區的戶外公共空間，可免費參觀；若周邊另有期間限定活動，費用以主辦單位公告為準。',
  },
  {
    question: '什麼時候去最好看？',
    answer: '建議日落前抵達，先看鋁編結構在自然光下形成的影子，再一路停留到點燈後。晴天、陰天與夜間各有不同氣氛。',
  },
  {
    question: '建議停留多久？',
    answer: '只看月影潭心並拍照，可安排約一小時；若加上蘭潭散步、觀景或周邊步道，建議預留更充裕的半日行程。',
  },
  {
    question: '沒有開車怎麼前往？',
    answer: '可由嘉義車站搭乘市區公車前往「月影潭心」站，下車後短距離步行抵達。由高鐵嘉義站出發，可先搭 BRT 到嘉義車站再轉乘。班次可能調整，出發前請查看當日動態。',
  },
  {
    question: '現場方便停車嗎？',
    answer: '周邊有路邊與風景區停車空間，但假日傍晚較容易客滿。請依現場標線及告示停放，不要佔用紅線、出入口或步道。',
  },
  {
    question: '適合輪椅或嬰兒車嗎？',
    answer: '作品動線設有斜坡入口，主要觀景區也有鋪面；不過湖畔局部路面與坡度會受地形影響，雨後需留意濕滑。',
  },
  {
    question: '蘭潭水舞每天都有嗎？',
    answer: '蘭潭音樂噴泉通常依季節安排晚間場次，但可能因維修、天候或活動調整。不要只依舊文章時間前往，建議出發前查看嘉義市官方最新公告。',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const gallery = [
  { src: '/images/moonheart-main.webp', alt: '月影潭心鋁編藝術裝置與蘭潭湖畔草地', title: '鋁編起伏與湖畔', width: 1920, height: 1440 },
  { src: '/images/lantan-cloudy.webp', alt: '多雲天氣下的蘭潭湖面', title: '雲影落在蘭潭', width: 1800, height: 1201 },
  { src: '/images/lantan-fountain.webp', alt: '蘭潭音樂噴泉水景', title: '湖面水舞', width: 1800, height: 1200 },
  { src: '/images/lantan-panorama-2.webp', alt: '草坡前方的蘭潭湖景', title: '湖岸草坡', width: 1800, height: 1350 },
  { src: '/images/lantan-panorama-3.webp', alt: '蘭潭湖面與遠方林木', title: '靜水與遠林', width: 1280, height: 960 },
  { src: '/images/lantan-panorama.webp', alt: '樹蔭下眺望蘭潭湖面', title: '樹影中的湖', width: 1800, height: 1350 },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071713" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="月影潭心" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <title>{title}</title>
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {ogImageURL && <meta property="og:image:alt" content="蘭潭月影潭心 · 嘉義市蘭潭湖畔" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    <script type="application/ld+json" set:html={JSON.stringify(attractionStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>

    <header class="topbar">
      <div class="site-shell flex h-16 items-center justify-between gap-5">
        <a href="#top" class="flex min-w-max items-center gap-2.5 no-underline" aria-label="月影潭心，回到頁首">
          <img class="h-8 w-8 rounded-lg" src="/favicon.svg" alt="" width="32" height="32" aria-hidden="true" />
          <span>
            <span class="display-serif block text-lg font-semibold leading-none text-white">月影潭心</span>
            <span class="brand-subtitle mt-1 block text-[0.58rem] leading-none tracking-[0.16em] text-white/45">LANTAN · CHIAYI</span>
          </span>
        </a>
        <nav class="nav-scroll flex items-center gap-1 overflow-x-auto text-sm" aria-label="頁面導覽">
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#weather">天氣</a>
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#visit">行前</a>
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#transport">交通</a>
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#services">設施</a>
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#routes">路線</a>
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#gallery">照片</a>
          <a class="rounded-full px-3 py-2 text-white/70 no-underline hover:bg-white/10 hover:text-white" href="#card-maker">紀念卡</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/moonheart-main.webp" alt="嘉義蘭潭月影潭心鋁編公共藝術" width="1920" height="1440" fetchpriority="high" />
        <div class="hero-orbit" aria-hidden="true"></div>
        <div class="site-shell hero-content">
          <div class="eyebrow">嘉義市 · 蘭潭湖畔公共藝術</div>
          <h1 id="hero-title" class="hero-title">蘭潭月影<span>潭心</span></h1>
          <p class="hero-lead">沿著銀白色鋁編走進湖風、樹影與夜色之間。這不是一座只能遠觀的雕塑，而是一條讓人慢下來、穿行其中的光影路徑。</p>
          <div class="mt-6 flex flex-wrap gap-2" aria-label="景點摘要">
            <span class="pill">免費參觀</span>
            <span class="pill">戶外全天候開放</span>
            <span class="pill">建議傍晚至夜間</span>
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="primary-button no-underline" href="#visit">開始規劃</a>
            <a class="secondary-button no-underline" href={mapsURL} target="_blank" rel="noreferrer">開啟地圖導航 <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section id="reviews" class="rating-band" aria-labelledby="reviews-title">
        <div class="site-shell">
          <div class="eyebrow">GOOGLE 地圖用戶評價</div>
          <h2 id="reviews-title" class="section-title">來自訪客的真實評分</h2>
          <div class="rating-summary">
            <div class="rating-badge">
              <span class="rating-number">{ratingValue}</span>
              <span class="rating-stars" aria-hidden="true">★★★★★</span>
              <span class="rating-scale">/ 5</span>
            </div>
            <div class="rating-meta">
              <div class="rating-count">{ratingCount.toLocaleString('en-US')} 則 Google 地圖用戶評價</div>
              <p class="rating-synced">評分與評價數同步自谷歌地圖（Google Maps）用戶評價 · {ratingSynced} · <a href={mapsShareURL} target="_blank" rel="noopener noreferrer">點擊查看谷歌地圖全部評價 <span aria-hidden="true">↗</span></a></p>
            </div>
          </div>
          <p class="review-source">同步自 Google 地圖用戶評價，同步時間 {ratingSynced}；版權歸原作者與 Google 地圖所有。</p>
          <a class="primary-button no-underline mt-5" href={mapsShareURL} target="_blank" rel="noopener noreferrer">在谷歌地圖查看全部評價 <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="weather" class="site-shell py-24 md:py-32 weather-section" aria-labelledby="weather-title">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <div class="eyebrow">LIVE WEATHER · 即時天氣</div>
            <h2 id="weather-title" class="section-title">出門前，先看蘭潭天色</h2>
          </div>
          <p class="section-copy lg:justify-self-end">天氣直接影響湖面光影與夜間舒適度。下方為蘭潭月影潭心所在地的即時氣溫、降水機率與未來一週趨勢，幫你判斷要不要帶傘、要不要多帶一件外套。</p>
        </div>

        <div id="weatherWidget" class="weather-widget" aria-live="polite">
          <div class="weather-loading">天氣資料讀取中…</div>
        </div>
      </section>

      <section class="site-shell py-24 md:py-32" aria-labelledby="story-title">
        <div class="grid items-center gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">
          <div>
            <div class="eyebrow">ABOUT · 關於景點</div>
            <h2 id="story-title" class="section-title">關於蘭潭月影潭心</h2>
            <nav class="breadcrumb" aria-label="所在位置">蘭潭月影潭心 <span aria-hidden="true">›</span> 嘉義市 <span aria-hidden="true">›</span> 臺灣省 <span aria-hidden="true">›</span> 臺灣</nav>
            <p class="section-copy mt-6">歡迎來到蘭潭月影潭心，這裡即是「月影潭心」的核心景點，位於嘉義市東區的蘭潭風景區。作為嘉義東側湖畔的公共藝術地標，月影潭心是旅人走訪這片水域時的主要停留點。</p>
            <p class="section-copy mt-4">「月影潭心」由嘉義出生的藝術家王文志創作，以鋁片編織出延伸、起伏的有機結構。作品把「月影」、湖心水紋與「談心」的諧音放在同一個空間裡，遠看像銀色山脊，走進去則像穿過一片被光切開的森林。</p>
            <p class="section-copy mt-4">一側以階梯連接，另一側設有斜坡動線；白天能看見網格影子落在地面，入夜後燈光讓整座作品像漂浮在蘭潭邊的發光植物。</p>
            <p class="section-copy mt-4">造訪蘭潭月影潭心時，也能順遊周邊地標，包含{nearbyLandmark1}與{nearbyLandmark2}，串成嘉義東側的半日或一日路線。</p>
            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="border-l border-[#d3ad70]/50 pl-4">
                <div class="text-xs tracking-[0.16em] text-white/45">藝術家</div>
                <div class="display-serif mt-2 text-xl text-white">王文志</div>
              </div>
              <div class="border-l border-[#d3ad70]/50 pl-4">
                <div class="text-xs tracking-[0.16em] text-white/45">公開年份</div>
                <div class="display-serif mt-2 text-xl text-white">2012</div>
              </div>
            </div>
          </div>
          <figure class="relative overflow-hidden rounded-[2rem] border border-white/10">
            <img class="story-photo h-full w-full" src="/images/lantan-cloudy.webp" alt="蘭潭月影潭心周邊的雲天蘭潭湖景（嘉義市）" width="1800" height="1201" loading="lazy" decoding="async" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-6 pt-20 text-sm text-white/75">先看湖，再看作品；月影潭心的魅力來自它與蘭潭地景放在一起時的尺度感。</figcaption>
          </figure>
        </div>
      </section>

      <section id="history" class="site-shell py-24 md:py-32" aria-labelledby="history-title">
        <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <div class="eyebrow">HISTORY &amp; LEGEND</div>
            <h2 id="history-title" class="section-title">蘭潭與月影潭心的來歷</h2>
            <p class="section-copy mt-6">理解一處水域，先理解它與城市的關係。蘭潭不只是風景，也是嘉義城市發展與供水史上的重要角色。</p>
          </div>
          <div class="space-y-6">
            <article class="prose-block">
              <h3 class="display-serif text-2xl text-white">蘭潭：從埤塘到城市水源</h3>
              <p class="section-copy mt-3">蘭潭又稱紅毛埤，早年即為嘉義近郊重要的蓄水埤塘。日治時期闢建為嘉義市水道的水源之一（蘭潭貯水池），自此與城市日常用水緊密相連；今日的蘭潭風景區，則把這片水域轉化為市民與旅人共享的開放綠地。</p>
            </article>
            <article class="prose-block">
              <h3 class="display-serif text-2xl text-white">月影潭心：湖畔的公共藝術</h3>
              <p class="section-copy mt-3">月影潭心為嘉義市推動的公共藝術作品，由在地藝術家王文志以鋁編創作，把「月影」、湖心水紋與「談心」的諧音收進同一道作品。它不佔據展廳，而是沿著湖岸展開，成為蘭潭新世代的地標。</p>
            </article>
            <article class="prose-block">
              <h3 class="display-serif text-2xl text-white">地名與意境</h3>
              <p class="section-copy mt-3">「蘭潭」一名民間有多種說法，本站採中性轉述，不作定論；而「月影潭心」的動人處，在於它把看湖這件事變成一種慢下來的儀式——月映潭心、風過林梢，是這片水域留給所有人的共同風景。</p>
            </article>
          </div>
        </div>
      </section>

      <section id="visit" class="moon-grid border-y border-white/10 bg-[#0b1f19] py-24 md:py-32" aria-labelledby="visit-title">
        <div class="site-shell">
          <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
            <div>
              <div class="eyebrow">BEFORE YOU GO</div>
              <h2 id="visit-title" class="section-title">先把最重要的事看完</h2>
            </div>
            <p class="section-copy lg:justify-self-end">這裡是開放式湖畔景點，沒有售票口與固定入場時段。夜間照明、水舞及公車班次可能調整，頁面以不容易過期的行前判斷為主。</p>
          </div>

          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            <article class="info-card">
              <div class="info-label">門票 / 費用</div>
              <div class="info-value">免費</div>

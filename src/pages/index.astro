---
import Layout from '../layouts/Layout.astro';
import Sources from '../components/Sources.astro';
import { sources } from '../data/sources';

const title = '蘭潭月影潭心｜開放時間、交通停車、夜景與水舞';
const description =
  '嘉義蘭潭月影潭心旅遊指南，整理2026開放時間、門票資訊、交通公車、停車位置、夜景拍照及蘭潭音樂噴泉水舞時間，出發前一次掌握實用資訊。';
const path = '/';

const mapsURL =
  'https://www.google.com/maps/place/%E5%85%B0%E6%BD%AD%E6%9C%88%E5%BD%B1%E6%BD%AD%E5%BF%83/data=!4m7!3m6!1s0x346e9458614570cb:0xfde645383820da8b!8m2!3d23.465877!4d120.48071!16s%2Fg%2F11fxxxvc6p!19sChIJy3BFYViUbjQRi9ogODhF5v0?authuser=0&hl=zh-CN&rclk=1';
const mapsShareURL = 'https://maps.app.goo.gl/TGMYG7zRJhNdXm1q9';
const govtTourismURL = sources.attraction;
const ratingValue = 4.2;
const ratingCount = 4194;
const ratingSynced = '2026 年 10 月';
const nearbyLandmark1 = '蘭潭音樂噴泉';
const nearbyLandmark2 = '檜意森活村';

const faqs = [
  {
    question: '蘭潭月影潭心什麼時候開放？點燈時間是幾點？',
    answer: '月影潭心位於蘭潭風景區的戶外公共空間，官方資料列為 24 小時開放。夜間有燈光變化，固定亮燈及熄燈時刻以現場告示為準，建議在日落前後一次收集日景與夜景。確切亮燈與音樂噴泉場次會隨季節、維護與天候調整，出發前請以現場與嘉義市官方公告為準。',
  },
  {
    question: '蘭潭月影潭心需要門票嗎？',
    answer: '月影潭心是戶外公共藝術；旅遊介紹常列免費，但官方開放資料有收費欄位而未附票價。本站不提供售票，費用請依官方聯絡資訊與現場告示確認，詳見開放時間與門票頁。',
  },
  {
    question: '什麼時候去最好看？',
    answer: '建議日落前抵達，先看鋁編結構在自然光下形成的影子，再一路停留到點燈後。晴天、陰天與夜間各有不同氣氛。',
  },
  {
    question: '建議停留多久？',
    answer: '只看月影潭心並拍照，可安排約一小時；若加上蘭潭散步、觀景或周邊步道，建議預留更充裕的半日行程。',
  },
  {
    question: '沒有開車怎麼前往？',
    answer: '可由嘉義車站轉乘往嘉大校區的中山幹線（綠線／綠 A 線），於「月影潭心」站下車，官方資料列步行約 1 分鐘。由高鐵嘉義站出發，可先搭 BRT 到嘉義車站再轉乘。班次可能調整，出發前請查看當日動態。',
  },
  {
    question: '現場方便停車嗎？',
    answer: '周邊有路邊與風景區停車空間，但假日傍晚較容易客滿。請依現場標線及告示停放，不要佔用紅線、出入口或步道。',
  },
  {
    question: '適合輪椅或嬰兒車嗎？',
    answer: '作品動線設有斜坡入口，主要觀景區也有鋪面；不過湖畔局部路面與坡度會受地形影響，雨後需留意濕滑。',
  },
  {
    question: '蘭潭水舞每天都有嗎？',
    answer: '蘭潭音樂噴泉通常依季節安排晚間場次，但可能因維修、天候或活動調整。不要只依舊文章時間前往，建議出發前查看嘉義市官方最新公告；詳細場次與最新恢復日期請見本站「音樂噴泉水舞」專頁。',
  },
];

const gallery = [
  { src: '/images/moonheart-main.webp', alt: '月影潭心鋁編藝術裝置與蘭潭湖畔草地', title: '鋁編起伏與湖畔', width: 1920, height: 1440 },
  { src: '/images/lantan-cloudy.webp', alt: '多雲天氣下的蘭潭湖面', title: '雲影落在蘭潭', width: 1800, height: 1201 },
  { src: '/images/lantan-fountain.webp', alt: '蘭潭音樂噴泉水景', title: '湖面水舞', width: 1800, height: 1200 },
  { src: '/images/lantan-panorama-2.webp', alt: '草坡前方的蘭潭湖景', title: '湖岸草坡', width: 1800, height: 1350 },
  { src: '/images/lantan-panorama-3.webp', alt: '蘭潭湖面與遠方林木', title: '靜水與遠林', width: 1280, height: 960 },
  { src: '/images/lantan-panorama.webp', alt: '樹蔭下眺望蘭潭湖面', title: '樹影中的湖', width: 1800, height: 1350 },
];
---

<Layout title={title} description={description} path={path} faqs={faqs}>
  <section id="top" class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src="/images/moonheart-main.webp" srcset="/images/responsive/moonheart-main-640.webp 640w, /images/responsive/moonheart-main-960.webp 960w, /images/moonheart-main.webp 1920w" sizes="100vw" alt="嘉義蘭潭月影潭心鋁編公共藝術" width="1920" height="1440" fetchpriority="high" />
    <div class="hero-orbit" aria-hidden="true"></div>
    <div class="site-shell hero-content">
      <div class="eyebrow">嘉義市 · 蘭潭湖畔公共藝術</div>
      <h1 id="hero-title" class="hero-title">蘭潭月影<span>潭心</span></h1>
      <p class="hero-lead">沿著銀白色鋁編走進湖風、樹影與夜色之間。這不是一座只能遠觀的雕塑，而是一條讓人慢下來、穿行其中的光影路徑。</p>
      <div class="mt-6 flex flex-wrap gap-2" aria-label="景點摘要">
        <a class="pill" href="/opening-hours/">開放時間與門票</a>
        <span class="pill">戶外全天候開放</span>
        <span class="pill">建議傍晚至夜間</span>
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="primary-button no-underline" href="#visit">開始規劃</a>
        <a class="secondary-button no-underline" href={mapsURL} target="_blank" rel="noreferrer">開啟地圖導航 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="reviews" class="rating-band" aria-labelledby="reviews-title">
    <div class="site-shell">
      <div class="eyebrow">GOOGLE 地圖用戶評價</div>
      <h2 id="reviews-title" class="section-title">Google 地圖歷史評分</h2>
      <div class="rating-summary">
        <div class="rating-badge">
          <span class="rating-number">{ratingValue}</span>
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <span class="rating-scale">/ 5</span>
        </div>
        <div class="rating-meta">
          <div class="rating-count">{ratingCount.toLocaleString('en-US')} 則 Google 地圖用戶評價</div>
          <p class="rating-synced">Google 地圖歷史評分快照 · {ratingSynced} · <a href={mapsShareURL} target="_blank" rel="noopener noreferrer">點擊查看谷歌地圖全部評價 <span aria-hidden="true">↗</span></a></p>
        </div>
      </div>
      <p class="review-source">Google 地圖歷史評分快照，快照日期 {ratingSynced}；版權歸原作者與 Google 地圖所有。</p>
      <a class="primary-button no-underline mt-5" href={mapsShareURL} target="_blank" rel="noopener noreferrer">在谷歌地圖查看全部評價 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="weather" class="site-shell py-24 md:py-32 weather-section" aria-labelledby="weather-title">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div>
        <div class="eyebrow">LIVE WEATHER · 即時天氣</div>
        <h2 id="weather-title" class="section-title">出門前，先看蘭潭天色</h2>
      </div>
      <p class="section-copy lg:justify-self-end">天氣直接影響湖面光影與夜間舒適度。下方為蘭潭月影潭心所在地的即時氣溫、降水機率與未來一週趨勢，幫你判斷要不要帶傘、要不要多帶一件外套。</p>
    </div>

    <div id="weatherWidget" class="weather-widget" aria-live="polite">
      <div class="weather-loading">天氣資料讀取中…</div>
    </div>
  </section>

  <section class="site-shell py-24 md:py-32" aria-labelledby="story-title">
    <div class="grid items-center gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">
      <div>
        <div class="eyebrow">ABOUT · 關於景點</div>
        <h2 id="story-title" class="section-title">關於蘭潭月影潭心</h2>
        <nav class="breadcrumb" aria-label="所在位置"><a href="/">蘭潭月影潭心</a> <span aria-hidden="true">›</span> 嘉義市 <span aria-hidden="true">›</span> 臺灣省 <span aria-hidden="true">›</span> 臺灣</nav>
        <p class="section-copy mt-6">歡迎來到蘭潭月影潭心，這裡即是「月影潭心」的核心景點，位於嘉義市東區的蘭潭風景區。作為嘉義東側湖畔的公共藝術地標，月影潭心是旅人走訪這片水域時的主要停留點。</p>
        <p class="section-copy mt-4">「月影潭心」由嘉義出生的藝術家王文志創作，以鋁片編織出延伸、起伏的有機結構。作品把「月影」、湖心水紋與「談心」的諧音放在同一個空間裡，遠看像銀色山脊，走進去則像穿過一片被光切開的森林。</p>
        <p class="section-copy mt-4">一側以階梯連接，另一側設有斜坡動線；白天能看見網格影子落在地面，入夜後燈光讓整座作品像漂浮在蘭潭邊的發光植物。</p>
        <p class="section-copy mt-4">造訪蘭潭月影潭心時，也能順遊周邊地標，包含{nearbyLandmark1}與{nearbyLandmark2}，串成嘉義東側的半日或一日路線。</p>
        <div class="mt-8 grid grid-cols-2 gap-4">
          <div class="border-l border-[#d3ad70]/50 pl-4">
            <div class="text-xs tracking-[0.16em] text-white/45">藝術家</div>
            <div class="display-serif mt-2 text-xl text-white">王文志</div>
          </div>
          <div class="border-l border-[#d3ad70]/50 pl-4">
            <div class="text-xs tracking-[0.16em] text-white/45">主要材質</div>
            <div class="display-serif mt-2 text-xl text-white">鋁片編織</div>
          </div>
        </div>
      </div>
      <figure class="relative overflow-hidden rounded-[2rem] border border-white/10">
        <img class="story-photo h-full w-full" src="/images/lantan-cloudy.webp" alt="蘭潭月影潭心周邊的雲天蘭潭湖景（嘉義市）" width="1800" height="1201" loading="lazy" decoding="async" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-6 pt-20 text-sm text-white/75">先看湖，再看作品；月影潭心的魅力來自它與蘭潭地景放在一起時的尺度感。</figcaption>
      </figure>
    </div>
  </section>

  <section id="history" class="site-shell py-24 md:py-32" aria-labelledby="history-title">
    <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <div class="eyebrow">HISTORY &amp; LEGEND</div>
        <h2 id="history-title" class="section-title">蘭潭與月影潭心的來歷</h2>
        <p class="section-copy mt-6">理解一處水域，先理解它與城市的關係。蘭潭不只是風景，也是嘉義城市發展與供水史上的重要角色。</p>
      </div>
      <div class="space-y-6">
        <article class="prose-block">
          <h3 class="display-serif text-2xl text-white">蘭潭：從埤塘到城市水源</h3>
          <p class="section-copy mt-3">蘭潭又稱紅毛埤，早年即為嘉義近郊重要的蓄水埤塘。日治時期闢建為嘉義市水道的水源之一（蘭潭貯水池），自此與城市日常用水緊密相連；今日的蘭潭風景區，則把這片水域轉化為市民與旅人共享的開放綠地。</p>
        </article>
        <article class="prose-block">
          <h3 class="display-serif text-2xl text-white">月影潭心：湖畔的公共藝術</h3>
          <p class="section-copy mt-3">月影潭心為嘉義市推動的公共藝術作品，由在地藝術家王文志以鋁編創作，把「月影」、湖心水紋與「談心」的諧音收進同一道作品。它不佔據展廳，而是沿著湖岸展開，成為蘭潭新世代的地標。</p>
        </article>
        <article class="prose-block">
          <h3 class="display-serif text-2xl text-white">地名與意境</h3>
          <p class="section-copy mt-3">「蘭潭」一名民間有多種說法，本站採中性轉述，不作定論；而「月影潭心」的動人處，在於它把看湖這件事變成一種慢下來的儀式——月映潭心、風過林梢，是這片水域留給所有人的共同風景。</p>
        </article>
      </div>
    </div>
  </section>

  <section id="visit" class="moon-grid border-y border-white/10 bg-[#0b1f19] py-24 md:py-32" aria-labelledby="visit-title">
    <div class="site-shell">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <div class="eyebrow">BEFORE YOU GO</div>
          <h2 id="visit-title" class="section-title">先把最重要的事看完</h2>
        </div>
        <p class="section-copy lg:justify-self-end">官方資料列月影潭心每日 24 小時開放；藝術裝置照明與旁邊的音樂噴泉是不同設施。先確認想看日景、燈光還是水舞，再選擇抵達時間與回程交通。</p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <article class="info-card">
          <div class="info-label">門票 / 費用</div>
          <div class="info-value">費用說明</div>
          <p class="mt-3 text-sm leading-6 text-white/55"><a href="/opening-hours/">查看費用資料與查詢方式 ↗</a></p>
        </article>
        <article class="info-card">
          <div class="info-label">開放狀態</div>
          <div class="info-value">全天候</div>
          <p class="mt-3 text-sm leading-6 text-white/55">夜間請留意照明、天氣與現場公告。</p>
        </article>
        <article class="info-card">
          <div class="info-label">最佳時段</div>
          <div class="info-value">夜間光影</div>
          <p class="mt-3 text-sm leading-6 text-white/55">一次收集白天結構、夕照與點燈。</p>
        </article>
        <article class="info-card">
          <div class="info-label">建議停留</div>
          <div class="info-value">約 1–1.5 小時</div>
          <p class="mt-3 text-sm leading-6 text-white/55">加走湖畔步道可安排半日。</p>
        </article>
        <article class="info-card">
          <div class="info-label">無障礙</div>
          <div class="info-value">設有斜坡</div>
          <p class="mt-3 text-sm leading-6 text-white/55">雨後鋪面與坡道可能濕滑。</p>
        </article>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <article class="glass-panel rounded-[1.5rem] p-6 md:p-8">
          <div class="flex items-start gap-4">
            <span class="route-badge" aria-hidden="true">P</span>
            <div>
              <h3 class="display-serif text-2xl text-white">停車資訊</h3>
              <p class="mt-3 leading-7 text-white/65">月影潭心周邊有路邊停車與蘭潭風景區停車空間，收費與可停區域依停車場及路邊告示辨識。假日傍晚與活動時段較容易滿位，抵達後請以現場標線、告示與交通人員指引為準。</p>
              <ul class="mt-4 grid gap-2 text-sm leading-6 text-white/55">
                <li>• 不佔用紅線、消防通道、住家出入口及步道。</li>
                <li>• 路邊下車時留意彎道與自行車。</li>
                <li>• 如需廁所，先查看現場導覽牌指示與開放狀況。</li>
              </ul>
            </div>
          </div>
        </article>
        <article class="glass-panel rounded-[1.5rem] p-6 md:p-8">
          <div class="flex items-start gap-4">
            <span class="route-badge" aria-hidden="true">☾</span>
            <div>
              <h3 class="display-serif text-2xl text-white">夜間遊覽提醒</h3>
              <p class="mt-3 leading-7 text-white/65">月影潭心最適合慢慢看光影，但湖畔夜間風大、蚊蟲多，雨後也容易濕滑。建議穿防滑鞋，帶薄外套與防蚊用品，不攀爬作品外緣。</p>
              <p class="mt-4 text-sm leading-6 text-[#d3ad70]">水舞場次會隨季節、維護與天氣調整，出發前請查嘉義市官方公告。</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="water-show" class="site-shell py-24 md:py-32" aria-labelledby="water-show-title">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div>
        <div class="eyebrow">2026 FOUNTAIN · 音樂噴泉</div>
        <h2 id="water-show-title" class="section-title">蘭潭音樂噴泉時間與最新公告</h2>
      </div>
      <p class="section-copy lg:justify-self-end">月影潭心旁邊的蘭潭音樂噴泉是許多遊客順遊的重點。場次會隨季節調整，以下為目前公開的時段與近期狀態，出發前請以官方公告為準。</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <article class="glass-panel rounded-[1.5rem] p-6 md:p-8">
        <h3 class="display-serif text-2xl text-white">冬令場次（10 月–翌年 3 月）</h3>
        <p class="mt-3 leading-7 text-white/65">嘉義市觀光旅遊網列出的冬令晚間場次為 <strong class="text-white/90">18:30、19:30、20:30、21:30</strong>，依季節時刻表安排，現場如有停演公告則優先適用。</p>
        <p class="mt-4 text-sm leading-6 text-white/55">夏令（4–9 月）為 19:30、20:30、21:30；噴泉場次與裝置照明分開安排。</p>
      </article>
      <article class="glass-panel rounded-[1.5rem] p-6 md:p-8">
        <h3 class="display-serif text-2xl text-white">最新公告與恢復展演</h3>
        <ul class="mt-3 grid gap-2 text-sm leading-7 text-white/65">
          <li>• 2026-02-25：因水位偏低，蘭潭音樂噴泉暫停展演。</li>
          <li>• 2026-08-28：恢復展演。</li>
          <li>• 本頁資訊最近核對日期：2026-11-26。</li>
        </ul>
